# ── Google Ads API kimlik bilgileri ─────────────────────────────
# Developer token: Google Ads MCC hesabı > Tools > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client, "Desktop app")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# `npm run auth` ile üretilir
GOOGLE_ADS_REFRESH_TOKEN=

# MCC (yönetici) hesabı üzerinden erişiyorsan MCC customer ID (tiresiz, örn: 1234567890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Güvenlik kelepçeleri ────────────────────────────────────────
# Yazma araçları tamamen kapalı başlasın istiyorsan 0 yap
ADSPILOT_WRITE_ENABLED=1
# Bir kampanya bütçesinin çıkabileceği en yüksek GÜNLÜK tutar (hesap para biriminde)
ADSPILOT_MAX_DAILY_BUDGET=500

# ── Hosted mod (npm run serve) — yalnız çok kullanıcılı sunucu için ─────
# Refresh token şifreleme anahtarı (min 32 karakter). Üret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UYARI: kaybedilirse kayıtlı tüm kullanıcı token'ları çözülemez.
ADSPILOT_MASTER_KEY=

# Kullanıcı veritabanı yolu (varsayılan: ./adspilot.db)
ADSPILOT_DB=

# Sunucunun dışarıdan görünen adresi — OAuth redirect_uri bundan üretilir,
# Google Cloud'daki "Yetkili yönlendirme URI'leri" ile BİREBİR eşleşmeli:
#   <ADSPILOT_PUBLIC_URL>/oauth/callback
ADSPILOT_PUBLIC_URL=http://localhost:8787
PORT=8787

# Ters proxy arkasındaysan izinli Host adları (virgüllü) — DNS rebinding koruması
# için gerekir. Örn: adspilot.animerank.com.tr
ADSPILOT_ALLOWED_HOSTS=

# Kullanıcı başına hız sınırı. TÜM kullanıcılar tek developer token'ı paylaşır
# ve Google'ın günlük kotası TOKEN başınadır — tek bir aşırı kullanıcı herkesi
# durdurabilir. Bu sınırlar o paylaşılan kaynağı korur.
ADSPILOT_RATE_PER_MINUTE=120
ADSPILOT_RATE_PER_DAY=2000

# AGPL §13: bu servisi kullananlara sunulacak KAYNAK KOD adresi.
# Kodu değiştirip dağıtıyorsan KENDİ deponu göster — varsayılan (upstream)
# adres senin değiştirilmiş sürümünün kaynağını sunmaz ve lisans ihlali olur.
ADSPILOT_SOURCE_URL=

# --- Network-verified approval (GSMA Open Gateway / CAMARA via Nokia Network-as-Code) ---
# Optional. When set, spend-increasing approvals consult the SIM Swap API first:
# a recently swapped approver SIM refuses the action BEFORE any human prompt.
# Get a key by registering at https://networkascode.nokia.io (free tier available).
ADSPILOT_NAC_TOKEN=
# E.164 number of the human whose approval the network verifies. REQUIRED if the
# token is set — with a token but no number, spend increases are refused (fail closed).
ADSPILOT_APPROVER_PHONE=
# SIM-swap lookback window for high-risk actions, in hours. Clamped to the CAMARA
# range 1-2400; unusable values fall back to 72 (medium-risk
# actions such as budget increases always use the tighter of 24h and this value).
ADSPILOT_SIMSWAP_WINDOW_HOURS=72

# ── SIM-Swap SİMÜLASYON kanalı (jüri/demo — NaC token'sız çalıştırma) ──────
# Tanımlıysa gerçek SDK yerine simüle kanal kullanılır ve üretilen HER metin
# (kanıt satırı, ret mesajı, stderr) açıkça "SİMÜLASYON" ibaresi taşır —
# gerçek ağ doğrulaması gibi sunulamaz.
#   temiz   -> SIM değişimi yok sayılır, onay akışı normal ilerler
#   degisti -> SIM değişmiş sayılır: SERT RET, onay istemi hiç gösterilmez
# Başka her değer doğrulama anında Türkçe hatayla reddedilir (kapalı arıza;
# sunucu başlangıçta düşmez). ADSPILOT_APPROVER_PHONE simülasyonda da ZORUNLU,
# ADSPILOT_NAC_TOKEN gerekmez. Token ve simülasyon BİRLİKTE tanımlıysa çelişkili
# yapılandırma sayılır ve işlem reddedilir (belirsizlikte gevşek kanal seçilmez).
ADSPILOT_NAC_SIMULATE=

# ── Number Verification SİMÜLASYON kanalı (güven zincirinin 2. halkası) ────
# DÜRÜSTLÜK NOTU: burada YALNIZ simülasyon vardır. Gerçek CAMARA Number
# Verification, cihazın kendi mobil veri bağlantısına bağlı, CİHAZ-TARAFLI bir
# OIDC akışıdır; operatör doğrulamayı cihaz üzerinden yapar. Ajanın yanında
# çalışan bir MCP sunucusunun böyle bir bağlantısı yoktur — hangi kimlik bilgisi
# olursa olsun bu API'yi tek başına ÇAĞIRAMAZ. Yol haritası: onay isteğinin
# onaylayıcının cihazındaki bir eşlik uygulamasına (mobil uygulama veya cihaz
# akışı sayfası) gitmesi, NV akışını ORANIN koşturup imzalı sonucu geri vermesi.
# O eşlik uygulaması gelene kadar aşağıdaki değerler yalnızca SİMÜLE eder ve
# üretilen HER metin açıkça "SİMÜLASYON" ibaresi taşır.
#   dogrulandi -> onay isteği hat sahibinin cihazından geliyor sayılır (kanıt satırı)
#   uyusmadi   -> SERT RET: SIM Swap temiz olsa bile onay istemi gösterilmez
# Yalnız HIGH risk katmanında koşar (yayına alma, canlı kampanya değişikliği);
# bütçe artışı gibi MEDIUM işlemlerde bu halka hiç çalışmaz. Başka her değer
# doğrulama anında Türkçe hatayla reddedilir (kapalı arıza) ve ham değer, sır
# ihtimaline karşı hata metnine yankılanmaz. ADSPILOT_APPROVER_PHONE burada da
# ZORUNLU. ADSPILOT_NAC_SIMULATE'ten BAĞIMSIZDIR: gerçek ADSPILOT_NAC_TOKEN ile
# birlikte de kullanılabilir (çelişki kuralı yalnız NAC token + NAC_SIMULATE
# ikilisi içindir).
ADSPILOT_NV_SIMULATE=

# ── Ağ kapısı KARAR GÜNLÜĞÜ (denetlenebilirlik izi) ────────────────────────
# Tanımsızsa günlük tamamen KAPALIDIR: hiçbir dosya oluşturulmaz, hiçbir şey
# yazılmaz. Tanımlıysa risk etiketli HER ağ kararı (RET ve GEÇİŞ) bu dosyaya
# JSONL olarak eklenir — satır başına bir JSON nesnesi:
#   zaman (ISO-8601), eylem (kısa özet), hesapId, risk,
#   karar ("gecti"|"ret"|"kapali"),
#   simSwapKanali ("gercek"|"simulasyon"|"kapali"|"calismadi"),
#   nvKanali ("simulasyon"|"calismadi"; halka koşmadıysa alan hiç yazılmaz),
#   pencereSaat, maskeliNumara,
#   retNedeniKisa (sabit kısa kod, ör. "sim-degisti" / "nv-uyusmadi")
# Zincirin iki halkası AYRI alanlara yazılır: "gerçek CAMARA sorgusuyla mı
# geçti, simülasyonla mı" ayrımı günlüğün var olma sebebidir ve tek bir
# alana ezilmez.
# SIR YAZILMAZ: tam onaylayıcı numarası, NaC token'ı veya ham upstream hata
# metni ASLA girmez; numara yalnız MASKELİ hâliyle (+905*****33) kaydedilir ve
# ret nedeni serbest metin değil sabit sözlükten bir koddur.
# Günlük bir GÖZLEM aracıdır, KAPI DEĞİLDİR: yazma hatası (bozuk yol, dolu
# disk, salt-okunur dizin) onay akışını ASLA düşürmez — stderr'e tek satır
# uyarı yazılır ve akış aynen sürer. Hedef dizin kendiliğinden OLUŞTURULMAZ.
# Örn: ADSPILOT_DECISION_LOG=/var/log/adspilot/kararlar.jsonl
ADSPILOT_DECISION_LOG=
