# ── Google Ads API kimlik bilgileri ─────────────────────────────
# Developer token: Google Ads MCC hesabı > Tools > API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client, "Desktop app")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# `npm run auth` ile üretilir
GOOGLE_ADS_REFRESH_TOKEN=

# MCC (yönetici) hesabı üzerinden erişiyorsan MCC customer ID (tiresiz, örn: 1234567890)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Güvenlik kelepçeleri ────────────────────────────────────────
# Yazma araçları tamamen kapalı başlasın istiyorsan 0 yap
ADSPILOT_WRITE_ENABLED=1
# Bir kampanya bütçesinin çıkabileceği en yüksek GÜNLÜK tutar (hesap para biriminde)
ADSPILOT_MAX_DAILY_BUDGET=500

# ── Hosted mod (npm run serve) — yalnız çok kullanıcılı sunucu için ─────
# Refresh token şifreleme anahtarı (min 32 karakter). Üret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UYARI: kaybedilirse kayıtlı tüm kullanıcı token'ları çözülemez.
ADSPILOT_MASTER_KEY=

# Kullanıcı veritabanı yolu (varsayılan: ./adspilot.db)
ADSPILOT_DB=

# Sunucunun dışarıdan görünen adresi — OAuth redirect_uri bundan üretilir,
# Google Cloud'daki "Yetkili yönlendirme URI'leri" ile BİREBİR eşleşmeli:
#   <ADSPILOT_PUBLIC_URL>/oauth/callback
ADSPILOT_PUBLIC_URL=http://localhost:8787
PORT=8787

# Ters proxy arkasındaysan izinli Host adları (virgüllü) — DNS rebinding koruması
# için gerekir. Örn: adspilot.animerank.com.tr
ADSPILOT_ALLOWED_HOSTS=

# Kullanıcı başına hız sınırı. TÜM kullanıcılar tek developer token'ı paylaşır
# ve Google'ın günlük kotası TOKEN başınadır — tek bir aşırı kullanıcı herkesi
# durdurabilir. Bu sınırlar o paylaşılan kaynağı korur.
ADSPILOT_RATE_PER_MINUTE=120
ADSPILOT_RATE_PER_DAY=2000

# AGPL §13: bu servisi kullananlara sunulacak KAYNAK KOD adresi.
# Kodu değiştirip dağıtıyorsan KENDİ deponu göster — varsayılan (upstream)
# adres senin değiştirilmiş sürümünün kaynağını sunmaz ve lisans ihlali olur.
ADSPILOT_SOURCE_URL=

# --- Network-verified approval (GSMA Open Gateway / CAMARA via Nokia Network-as-Code) ---
# Optional. When set, spend-increasing approvals consult the SIM Swap API first:
# a recently swapped approver SIM refuses the action BEFORE any human prompt.
# Get a key by registering at https://networkascode.nokia.io (free tier available).
ADSPILOT_NAC_TOKEN=
# E.164 number of the human whose approval the network verifies. REQUIRED if the
# token is set — with a token but no number, spend increases are refused (fail closed).
ADSPILOT_APPROVER_PHONE=
# SIM-swap lookback window for high-risk actions, in hours. Clamped to the CAMARA
# range 1-2400; unusable values fall back to 72 (medium-risk
# actions such as budget increases always use the tighter of 24h and this value).
ADSPILOT_SIMSWAP_WINDOW_HOURS=72

# ── SIM-Swap SİMÜLASYON kanalı (jüri/demo — NaC token'sız çalıştırma) ──────
# Tanımlıysa gerçek SDK yerine simüle kanal kullanılır ve üretilen HER metin
# (kanıt satırı, ret mesajı, stderr) açıkça "SİMÜLASYON" ibaresi taşır —
# gerçek ağ doğrulaması gibi sunulamaz.
#   temiz   -> SIM değişimi yok sayılır, onay akışı normal ilerler
#   degisti -> SIM değişmiş sayılır: SERT RET, onay istemi hiç gösterilmez
# Başka her değer doğrulama anında Türkçe hatayla reddedilir (kapalı arıza;
# sunucu başlangıçta düşmez). ADSPILOT_APPROVER_PHONE simülasyonda da ZORUNLU,
# ADSPILOT_NAC_TOKEN gerekmez. Token ve simülasyon BİRLİKTE tanımlıysa çelişkili
# yapılandırma sayılır ve işlem reddedilir (belirsizlikte gevşek kanal seçilmez).
ADSPILOT_NAC_SIMULATE=

# ── Number Verification SİMÜLASYON kanalı (güven zincirinin 2. halkası) ────
# DÜRÜSTLÜK NOTU: burada YALNIZ simülasyon vardır. Gerçek CAMARA Number
# Verification, cihazın kendi mobil veri bağlantısına bağlı, CİHAZ-TARAFLI bir
# OIDC akışıdır; operatör doğrulamayı cihaz üzerinden yapar. Ajanın yanında
# çalışan bir MCP sunucusunun böyle bir bağlantısı yoktur — hangi kimlik bilgisi
# olursa olsun bu API'yi tek başına ÇAĞIRAMAZ. Yol haritası: onay isteğinin
# onaylayıcının cihazındaki bir eşlik uygulamasına (mobil uygulama veya cihaz
# akışı sayfası) gitmesi, NV akışını ORANIN koşturup imzalı sonucu geri vermesi.
# O eşlik uygulaması gelene kadar aşağıdaki değerler yalnızca SİMÜLE eder ve
# üretilen HER metin açıkça "SİMÜLASYON" ibaresi taşır.
#   dogrulandi -> onay isteği hat sahibinin cihazından geliyor sayılır (kanıt satırı)
#   uyusmadi   -> SERT RET: SIM Swap temiz olsa bile onay istemi gösterilmez
# Yalnız HIGH risk katmanında koşar (yayına alma, canlı kampanya değişikliği);
# bütçe artışı gibi MEDIUM işlemlerde bu halka hiç çalışmaz. Başka her değer
# doğrulama anında Türkçe hatayla reddedilir (kapalı arıza) ve ham değer, sır
# ihtimaline karşı hata metnine yankılanmaz. ADSPILOT_APPROVER_PHONE burada da
# ZORUNLU. ADSPILOT_NAC_SIMULATE'ten BAĞIMSIZDIR: gerçek ADSPILOT_NAC_TOKEN ile
# birlikte de kullanılabilir (çelişki kuralı yalnız NAC token + NAC_SIMULATE
# ikilisi içindir).
ADSPILOT_NV_SIMULATE=

# ── Halka 3: CİHAZ ERİŞİLEBİLİRLİĞİ (Device Reachability) ──────────────────
# Sorduğu soru: "onaylayıcının hattı şu an ağdan erişilebilir durumda mı?".
# NV'nin aksine bu halkanın GERÇEK sorgusu sunucudan yapılabilir: CAMARA Device
# Status / Reachability uç noktası tek tanımlayıcı olarak telefon numarasını
# ister, cihaz-taraflı akış GEREKMEZ.
#
# DÜRÜST TAKAS: erişilebilirlik MEŞRU olarak dalgalanır (uçak modu, kapsama
# boşluğu, kapalı telefon). Kapalı arıza ilkesi gereği "erişilemez" yanıtı RET
# üretir. Yanlış-pozitif riski iki biçimde sınırlanır: halka yalnız HIGH
# katmanda koşar ve GERÇEK kanal aşağıdaki anahtarla OPT-IN'dir.
#
# Gerçek sorgu anahtarı — varsayılan KAPALI. Kapalıyken ADSPILOT_NAC_TOKEN
# tanımlı olsa bile sorgu YAPILMAZ ve denetim izine "kapali" yazılır; böylece
# yalnızca SIM-Swap için token tanımlayan bir operatör, hiç istemediği bir
# erişilebilirlik retiyle karşılaşmaz. Açmak için 1/true/evet/acik.
ADSPILOT_REACH_CHECK=
# SİMÜLASYON kanalı (jüri/demo — token'sız). Tanımlıysa gerçek SDK'ya HİÇ
# dokunulmaz ve üretilen HER metin açıkça "SİMÜLASYON" ibaresi taşır.
#   erisilebilir -> cihaz ağdan erişilebilir sayılır, akış normal ilerler
#   anormal      -> SERT RET: onay istemi hiç gösterilmez
# Başka her değer karar anında Türkçe hatayla reddedilir (kapalı arıza) ve ham
# değer, sır ihtimaline karşı hata metnine yankılanmaz. ADSPILOT_APPROVER_PHONE
# burada da ZORUNLU. ADSPILOT_REACH_CHECK açık VE ADSPILOT_NAC_TOKEN tanımlıyken
# bu değişkenin de tanımlı olması ÇELİŞKİ sayılır ve işlem reddedilir
# (belirsizlikte gevşek kanal seçilmez). İkisinden biri eksikse çelişki yoktur,
# çünkü ortada sorgulanabilecek gerçek bir kanal yoktur: anahtar açık ama token
# yoksa halka simüle kanaldan cevap verir ve çıktısı "SİMÜLASYON" etiketlidir.
ADSPILOT_REACH_SIMULATE=

# ── Halka 4: KONUM DOĞRULAMASI (beklenen ülke) ─────────────────────────────
# Sorduğu soru: "onaylayıcının hattı beklenen ülkenin DIŞINDA bir ülkede mi?".
# Harcama onayının beklenmedik bir coğrafyadan gelmesi, hesap ele geçirmenin
# tipik işaretlerindendir.
#
# BEKLENTİ UYDURULMAZ: aşağıdaki değer tanımlı DEĞİLSE halka HİÇ KOŞMAZ ve
# denetim izine "kapali" yazar. Varsayılan bir ülke türetmek, cevabı her zaman
# "temiz" çıkaran sessiz bir güvenlik kaybı olurdu. Tanımlı ama iki harfli bir
# ISO 3166-1 alpha-2 kodu değilse bu bir yapılandırma hatasıdır ve kapalı
# arızaya (RET) gider; ham değer hata metnine yankılanmaz.
# Örn: ADSPILOT_EXPECTED_COUNTRY=TR
ADSPILOT_EXPECTED_COUNTRY=
# SİMÜLASYON kanalı (jüri/demo — token'sız), "SİMÜLASYON" ibareli metinlerle:
#   beklenen    -> hat beklenen ülkede sayılır, akış normal ilerler
#   beklenmedik -> SERT RET: onay istemi hiç gösterilmez
# Yalnız HIGH katmanda ve YALNIZ ADSPILOT_EXPECTED_COUNTRY tanımlıyken koşar.
# ADSPILOT_NAC_TOKEN ile birlikte tanımlanması ÇELİŞKİ sayılır ve reddedilir.
ADSPILOT_LOC_SIMULATE=
#
# KAPSAM NOTU (dürüstlük): bu halka ÜLKE düzeyindedir. Gerçek kanal, CAMARA
# Device Status / Roaming uç noktasını sorgular (roaming boolean'ı + MCC'den
# eşlenen ISO-2 ülke listesi). CAMARA Location Verification'ın daire-alan
# (CIRCLE) sorgusu BİLEREK ertelendi: SDK'nın ürettiği Area tipinde merkez
# koordinatı ve yarıçap alanları HİÇ YOK, yani sorgulanacak alan tip güvenli
# kurulamıyor. Şehir/yarıçap düzeyi coğrafya bu kapının bugünkü vaadi DEĞİLDİR.
# Ağdan gelen ham ülke listesi ne ajana, ne kanıt satırına, ne de denetim izine
# yazılır; dışarı çıkan tek şey türetilmiş karardır ("beklenen ülkede" /
# "beklenen ülke dışında") ve yapılandırmadan gelen beklenen ülke kodudur.

# ── Halka 5: CİHAZ DEĞİŞİMİ (Device Swap) ──────────────────────────────────
# Sorduğu soru: "hat son N saatte YENİ BİR CİHAZA mı taşındı?".
# SIM Swap'ın yapısal ikizidir: aynı auth, aynı gövde şekli, saat bazlı pencere,
# tek boolean çıktı. Gördüğü senaryo SIM Swap'ın GÖREMEDİĞİDİR: saldırgan kartı
# hiç taşımadan hattı kendi telefonuna aldıysa 1. halka temiz cevap verir.
#
# PENCERE AYRI DEĞİŞKEN İSTEMEZ: yukarıdaki ADSPILOT_SIMSWAP_WINDOW_HOURS
# paylaşılır (aynı CAMARA aralığı, 1-2400 saat). Denetim izinde yine de KENDİ
# alanına yazılır (devSwapPencereSaat), çünkü hangi sorunun hangi pencereyle
# sorulduğu ayrı durmalıdır.
#
# Gerçek sorgu anahtarı — varsayılan KAPALI. Kapalıyken ADSPILOT_NAC_TOKEN
# tanımlı olsa bile sorgu YAPILMAZ ve denetim izine "kapali" yazılır.
# Açmak için 1/true/evet/acik.
ADSPILOT_DEVICESWAP_CHECK=
# SİMÜLASYON kanalı (jüri/demo — token'sız), "SİMÜLASYON" ibareli metinlerle:
#   temiz   -> yeni cihaza taşınma yok sayılır, akış normal ilerler
#   degisti -> SERT RET: onay istemi hiç gösterilmez
# Yalnız HIGH katmanda koşar. Başka her değer karar anında Türkçe hatayla
# reddedilir (kapalı arıza) ve ham değer hata metnine yankılanmaz.
# ADSPILOT_APPROVER_PHONE burada da ZORUNLU. ADSPILOT_DEVICESWAP_CHECK açık VE
# ADSPILOT_NAC_TOKEN tanımlıyken bu değişkenin de tanımlı olması ÇELİŞKİ sayılır
# ve reddedilir (belirsizlikte gevşek kanal seçilmez).
ADSPILOT_DEVICESWAP_SIMULATE=

# ── Halka 6: ÇAĞRI YÖNLENDİRME (Call Forwarding) ───────────────────────────
# Sorduğu soru: "onaylayıcının hattında KOŞULSUZ çağrı yönlendirme açık mı?".
# Açık yönlendirme, OTP/sesli doğrulamayı ele geçirmenin klasik yoludur: hat
# sahibinde kalır, SIM değişmez, cihaz değişmez, hat erişilebilir, ülke
# beklenendir — ama doğrulama çağrısı saldırgana gider. Önceki beş halkanın
# hiçbiri bu senaryoyu göremez.
#
# PII YOK: uç nokta yalnız "açık mı" boolean'ını döner; yönlendirmenin HANGİ
# numaraya yapıldığı ne sorulur, ne alınır, ne de bir metne yazılır.
#
# KAPALI ARIZA NOTU: CAMARA yanıtında "active" alanı OPSİYONELDİR. Okunamaması
# "yönlendirme yok" DEĞİL "bilinmiyor" demektir ve RET üretir. Şebeke bu sinyali
# sunmuyorsa (uç nokta 501 dönebilir) her yanıtsızlık da RET'tir — o durumda
# halka KAPATILMALIDIR, sessizce geçilmez.
#
# Gerçek sorgu anahtarı — varsayılan KAPALI. Açmak için 1/true/evet/acik.
ADSPILOT_CALLFWD_CHECK=
# SİMÜLASYON kanalı (jüri/demo — token'sız), "SİMÜLASYON" ibareli metinlerle:
#   kapali -> hatta koşulsuz yönlendirme YOK sayılır, akış normal ilerler
#   acik   -> SERT RET: onay istemi hiç gösterilmez
# (Buradaki "kapali" YÖNLENDİRMENİN kapalı olduğunu söyler; denetim izindeki
# "kapali" ise halkanın hiç koşmadığını söyler — aynı kelime, ayrı sözlük.)
# Yalnız HIGH katmanda koşar; diğer halkalarla aynı çelişki ve kapalı-arıza
# kuralları geçerlidir.
ADSPILOT_CALLFWD_SIMULATE=

# ── GECİKME NOTU: hiçbir halka VARSAYILAN OLARAK açılmaz ───────────────────
# Zincir uzadıkça HIGH katmandaki her onay, koşan her GERÇEK halka için bir
# CAMARA gidiş-dönüşü daha bekler (halka başına 10 sn timeout). Bu yüzden her
# halka YALNIZ kendi anahtarı ya da kendi simülasyonu tanımlıysa koşar:
#   3. halka -> ADSPILOT_REACH_CHECK      / ADSPILOT_REACH_SIMULATE
#   4. halka -> ADSPILOT_EXPECTED_COUNTRY / ADSPILOT_LOC_SIMULATE
#   5. halka -> ADSPILOT_DEVICESWAP_CHECK / ADSPILOT_DEVICESWAP_SIMULATE
#   6. halka -> ADSPILOT_CALLFWD_CHECK    / ADSPILOT_CALLFWD_SIMULATE
# ADSPILOT_NAC_TOKEN tanımlamak bunların HİÇBİRİNİ açmaz: yalnızca SIM-Swap
# için token tanımlayan bir operatör ne istemediği gecikmeyi ne de istemediği
# yanlış-pozitif retleri üstlenir. Kapalı halka sorgu yapmaz, kanıt satırı
# yazmaz ve denetim izine "kapali" yazar (sessiz kalmak, denetimde "sordum ve
# geçti" ile karışırdı).

# ── Ağ kapısı KARAR GÜNLÜĞÜ (denetlenebilirlik izi) ────────────────────────
# Tanımsızsa günlük tamamen KAPALIDIR: hiçbir dosya oluşturulmaz, hiçbir şey
# yazılmaz. Tanımlıysa risk etiketli HER ağ kararı (RET ve GEÇİŞ) bu dosyaya
# JSONL olarak eklenir — satır başına bir JSON nesnesi:
#   zaman (ISO-8601), eylem (kısa özet), hesapId, risk,
#   karar ("gecti"|"ret"|"kapali"),
#   simSwapKanali ("gercek"|"simulasyon"|"kapali"|"calismadi"),
#   nvKanali ("simulasyon"|"calismadi"),
#   reachKanali, locKanali, devSwapKanali, callFwdKanali
#     (aynı sözcük dağarcığı; halka koşmadıysa alan HİÇ yazılmaz),
#   pencereSaat, devSwapPencereSaat, maskeliNumara,
#   retNedeniKisa (sabit kısa kod: "sim-degisti" | "nv-uyusmadi" |
#     "cihaz-erisilemez" | "konum-beklenmedik" | "cihaz-degisti" |
#     "cagri-yonlendirme-acik" | "ag-yanitsiz" | yapılandırma kodları)
# Zincirin iki halkası AYRI alanlara yazılır: "gerçek CAMARA sorgusuyla mı
# geçti, simülasyonla mı" ayrımı günlüğün var olma sebebidir ve tek bir
# alana ezilmez.
# SIR YAZILMAZ: tam onaylayıcı numarası, NaC token'ı veya ham upstream hata
# metni ASLA girmez; numara yalnız MASKELİ hâliyle (+905*****33) kaydedilir ve
# ret nedeni serbest metin değil sabit sözlükten bir koddur.
# Günlük bir GÖZLEM aracıdır, KAPI DEĞİLDİR: yazma hatası (bozuk yol, dolu
# disk, salt-okunur dizin) onay akışını ASLA düşürmez — stderr'e tek satır
# uyarı yazılır ve akış aynen sürer. Hedef dizin kendiliğinden OLUŞTURULMAZ.
# Örn: ADSPILOT_DECISION_LOG=/var/log/adspilot/kararlar.jsonl
ADSPILOT_DECISION_LOG=
