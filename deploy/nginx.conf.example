# AdsPilot — nginx ters proxy örneği
#
# EN SIK YAPILAN HATA: `proxy_set_header Host $host;` satırını unutmak.
# O satır olmadan upstream'e "Host: 127.0.0.1:8787" gider; sunucunun DNS
# rebinding koruması izinli host listesiyle eşleşmez ve TÜM MCP trafiği
# 403 alır. Teşhisi zor bir arızadır — "hiçbir şey çalışmıyor" gibi görünür.
#
# Sunucu tarafında da şu ayarlanmalı:
#   ADSPILOT_PUBLIC_URL=https://adspilot.ornek.com
#   ADSPILOT_ALLOWED_HOSTS=adspilot.ornek.com

# /connect kimlik doğrulaması İSTEMEZ: IP bazlı sınır burada verilir.
limit_req_zone $binary_remote_addr zone=adspilot_connect:10m rate=10r/m;

server {
    listen 80;
    server_name adspilot.ornek.com;
    # TLS ZORUNLU: bearer API anahtarları ve OAuth kodları düz HTTP'de taşınamaz
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name adspilot.ornek.com;

    ssl_certificate     /etc/letsencrypt/live/adspilot.ornek.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/adspilot.ornek.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;

        # ── KRİTİK: bu satır olmadan tüm MCP trafiği 403 alır ──
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MCP Streamable HTTP: SSE akışları tamponlanmamalı ve erken kapanmamalı
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;
    }

    location = /connect {
        limit_req zone=adspilot_connect burst=5 nodelay;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
