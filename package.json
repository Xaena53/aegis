{
  "name": "adspilot-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xaena53/google-ads-mcp.git"
  },
  "description": "AdsPilot — Google Ads MCP server: connect your site, let Claude run your ads (write-enabled, human-approval gated)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "adspilot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "serve": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test \"test/*.test.ts\" \"test/brain/*.test.mjs\"",
    "auth": "node scripts/get-refresh-token.mjs",
    "smoke": "node scripts/smoke.mjs",
    "agent": "node scripts/demo-agent.mjs",
    "demo": "node scripts/demo-senaryo.mjs",
    "prova": "node scripts/prova.mjs",
    "agtest": "node --import tsx scripts/agDogrula.mts",
    "brain": "node scripts/growth-brain.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "google-ads-api": "^24.1.0",
    "network-as-code": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
