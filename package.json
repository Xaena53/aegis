{
  "name": "adspilot-mcp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "AdsPilot — Google Ads MCP server: connect your site, let Claude run your ads (write-enabled, human-approval gated)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "adspilot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "serve": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/util.test.ts test/siteExtract.test.ts test/store.test.ts test/rateLimit.test.ts",
    "auth": "node scripts/get-refresh-token.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "google-ads-api": "^24.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
