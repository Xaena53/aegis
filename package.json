{
  "name": "aegis-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xaena53/aegis.git"
  },
  "description": "Aegis — Google Ads MCP server: connect your site, let Claude run your ads (write-enabled, human-approval gated)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aegis-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/index.js",
    "serve": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test \"test/*.test.ts\" \"test/*.test.mjs\" \"test/brain/*.test.mjs\"",
    "auth": "node scripts/get-refresh-token.mjs",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "agent": "node scripts/demo-agent.mjs",
    "predemo": "npm run build",
    "demo": "node scripts/demo-senaryo.mjs",
    "preprova": "npm run build",
    "prova": "node scripts/prova.mjs",
    "agtest": "node --import tsx scripts/agDogrula.mts",
    "metatest": "node --import tsx scripts/metaDogrula.mts",
    "brain": "node scripts/growth-brain.mjs",
    "video": "node --import tsx scripts/video-demo.mts",
    "audit": "node scripts/bagimlilikDenetimi.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "google-ads-api": "^24.1.0",
    "network-as-code": "^10.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
